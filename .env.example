# Colab Agent Fleet Environment Variables
# Copy to .env and fill in your values

# REQUIRED: NVIDIA NIMs API key for Nemotron model
# Get at: https://integrate.api.nvidia.com
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Optional: Planner model (Ollama on cpu6/GPU)
# Default: gpt-oss:20b
MODELO_PLANEJADOR=gpt-oss:20b

# Optional: Target Colab sessions (comma-separated)
# Default: cpu1,cpu2,cpu3,cpu4,cpu5
MAQUINAS=cpu1,cpu2,cpu3,cpu4,cpu5

# Optional: GPU flags for planner session (cpu6)
# Default: --gpu t4
FLAGS_GPU=--gpu t4

# Optional: Promotion gates (JSON, overrides defaults in run_fleet.py)
# GATES={"min_unique_sources": 3, "max_dup_ratio": 0.15, "min_chars_per_result": 200, "min_success_ratio": 0.7}