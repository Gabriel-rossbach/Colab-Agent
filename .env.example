# Colab Agent Fleet Environment Variables
# Copy to .env and fill in your values

# REQUIRED: NVIDIA NIMs API key for Nemotron model
# Get at: https://integrate.api.nvidia.com
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Optional: Planner model (Ollama on cpu6/GPU)
# Default: gpt-oss:20b
MODELO_PLANEJADOR=gpt-oss:20b

# Optional: Target Colab sessions (comma-separated)
# Default: cpu1,cpu2,cpu3,cpu4,cpu5
MAQUINAS=cpu1,cpu2,cpu3,cpu4,cpu5

# Optional: GPU flags for planner session (cpu6)
# Default: --gpu t4
FLAGS_GPU=--gpu t4

# Optional: Promotion gate (JSON, overrides defaults in run_fleet.py)
# GATES={"min_success_ratio": 0.7}

# Web panel: required by the Spring Boot API, never used by Flutter as a build variable
# Use a long random value different from NVIDIA_API_KEY
FLEET_API_TOKEN=CHANGE_TO_A_LONG_RANDOM_TOKEN

# Docker/Caddy: local evaluation defaults; use your own public domain in production
PANEL_ADDRESS=:80
PANEL_HTTP_PORT=8080
PANEL_HTTPS_PORT=8443

# Optional: comma-separated origins only for cross-origin development
# Leave empty for the recommended same-origin deployment
FLEET_CORS_ALLOWED_ORIGINS=