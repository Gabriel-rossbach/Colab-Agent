{$PANEL_ADDRESS::80} {
	encode zstd gzip
	request_body {
		max_size 64KB
	}

	@api path /api/*
	reverse_proxy @api backend:8080

	root * /srv
	try_files {path} /index.html
	file_server

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
